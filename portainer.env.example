# Portainer Docker Standalone / downloaded compose.portainer.yaml.
# Save a private copy as .env and edit all paths and documentation addresses.
# Load it using Portainer's 'Load variables from .env file'. Do not source/eval.
BACKSTORY_IMAGE=ghcr.io/bcl1713/backstory:1.0.0
# Positive non-root IDs matching the wiki owner (rootful Docker, no userns).
BACKSTORY_UID=1000
BACKSTORY_GID=1000
# Existing canonical host paths ON THE DOCKER ENDPOINT, outside each other.
BACKSTORY_WIKI_ROOT='/absolute/path/to/wiki'
BACKSTORY_DATA_HOST_PATH='/absolute/path/to/backstory-data'
BACKSTORY_IDENTITY_PATH=.backstory-marker
# Begin read-only. Set false and redeploy after testing with a rehearsal wiki.
BACKSTORY_WIKI_READ_ONLY=true
# HTTPS through an existing Cloudflare connector OR Nginx Proxy Manager.
# Replace the following host, origin and IPs together. See docs/portainer.md.
BACKSTORY_COOKIE_MODE=https
BACKSTORY_ALLOWED_HOSTS=wiki.example.test
BACKSTORY_PROXY_MODE=trusted
BACKSTORY_CSRF_TRUSTED_ORIGINS=https://wiki.example.test
# Interface on the Docker host reachable ONLY by the intended proxy/connector.
BACKSTORY_BIND_ADDRESS=192.0.2.10
BACKSTORY_PORT=8000
# ACTUAL origin-side TCP peer, which can differ after Docker NAT.
BACKSTORY_TRUSTED_PROXY_IPS=192.0.2.20/32
BACKSTORY_PROXY_CLIENT_IP_HEADER=none
# No passwords, Cloudflare token or signing secret belong in this file.
# Portainer chooses the stack name in its UI; COMPOSE_FILE is unnecessary.
