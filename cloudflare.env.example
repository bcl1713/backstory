# Optional tunnel installation: copy to a NEW private .env; see docs/cloudflare.md.
# Docker Standalone, rootful/no userns, wiki owner 1000:1000 example.
# This is dotenv data, not a shell script. Do not source/eval it.
# Variable purposes, defaults and errors: docs/configuration.md.
COMPOSE_PROJECT_NAME=backstory-tunnel
COMPOSE_FILE=compose.cloudflare.yaml
# Pull the published image on the selected Docker endpoint; no local build needed.
BACKSTORY_IMAGE=ghcr.io/bcl1713/backstory:1.0.0
BACKSTORY_UID=1000
BACKSTORY_GID=1000
BACKSTORY_WIKI_ROOT='/absolute/path/to/testwiki'
# Create a NEW private local data directory, disjoint from wiki and checkout.
BACKSTORY_DATA_HOST_PATH='/absolute/path/to/backstory-tunnel-data'
# Existing owner-approved .backstory-marker is required; no hash is needed.
BACKSTORY_WIKI_READ_ONLY=true
BACKSTORY_ALLOWED_HOSTS=wiki.example.test
BACKSTORY_CSRF_TRUSTED_ORIGINS=https://wiki.example.test
# Example only: verify no conflict with endpoint/LAN/VPN/other Docker networks.
# Connector IP must be a usable IPv4 address inside this private subnet.
BACKSTORY_TUNNEL_SUBNET=172.30.241.0/29
BACKSTORY_TUNNEL_CONNECTOR_IP=172.30.241.3
# PATH ONLY, on the Docker endpoint host. Never put the token value in .env.
# Token is an existing mode-600 regular file owned by the selected effective user,
# outside wiki, checkout/build context and app-data directory.
CLOUDFLARE_TUNNEL_TOKEN_FILE='/absolute/private/path/cloudflare-tunnel-token'
# Manifest fixes HTTPS cookies, trusted mode, connector-only /32 and client-IP none.
# No application host port is published; public requests arrive via the tunnel.

# Optional fixed wiki date timezone; overrides saved browser-initialized setting.
# For Omaha use America/Chicago. Empty means use saved setting (UTC until initialized).
BACKSTORY_WIKI_TIMEZONE=
