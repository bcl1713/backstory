[Unit]
Description=Backstory automatic local validation and image publication
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/backstory-publisher/controller
Environment=PATH=%h/.local/share/backstory-publisher/tools/node_modules/.bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DOCKER_HOST=unix://%t/docker.sock
Environment=DOCKER_CONFIG=%h/.local/state/backstory-publisher/docker
Environment=BUILDX_BUILDER=backstory-publisher
Environment=FONTCONFIG_FILE=%h/.local/share/backstory-publisher/fonts/fonts.conf
Environment=GIT_TERMINAL_PROMPT=0
EnvironmentFile=-%h/.config/backstory-publisher/environment
UMask=0077
ExecStartPre=/usr/bin/install -d -m 0700 %h/.local/state/backstory-publisher/docker
# Reuse the existing GitHub identity; token bytes go only through stdin.
ExecStartPre=/bin/bash -o pipefail -c 'gh auth token --hostname github.com | docker login ghcr.io --username "$(gh api --hostname github.com user --jq .login)" --password-stdin'
ExecStart=/usr/bin/python3 scripts/local_publisher.py --state-dir %h/.local/state/backstory-publisher
Restart=on-failure
RestartSec=30s
KillMode=mixed
TimeoutStopSec=5h
NoNewPrivileges=yes

[Install]
WantedBy=default.target
