# Generate synthetic storage with: uv run python -m tests.fixtures.generate /tmp/backstory-demo
# For Compose, generate a NEW disposable fixture with --for-containers; see docs/development.md.
# Then load its fixture.env as documented. Never point development at live notes.
BACKSTORY_WIKI_ROOT=/tmp/backstory-demo/wiki
BACKSTORY_DATA_DIR=/tmp/backstory-demo/data
BACKSTORY_IDENTITY_PATH=Home.md
# Fill from the generated manifest; this is not a secret.
BACKSTORY_IDENTITY_SHA256=
BACKSTORY_COOKIE_MODE=localhost
BACKSTORY_ALLOWED_HOSTS=localhost,127.0.0.1
# The supplied Compose service deliberately uses localhost HTTP mode.
# Reverse-proxy trust is unsupported and must remain off.
BACKSTORY_PROXY_MODE=off
# Native runtime option; Compose uses defaults unless its service environment is extended.
# Retention is 30 days. Quota is logical payload accounting, not SQLite file size.
BACKSTORY_REVISION_QUOTA_BYTES=67108864
# application-secret is generated privately in DATA_DIR; never paste it here.
