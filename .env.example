# Linux/rootful Docker example for an existing wiki owned by host UID/GID 1000.
# Copy to a NEW .env in the checkout, keep it private, then edit every path.
# Compose reads this file; do not source/eval it. Use absolute host paths, no ~.
COMPOSE_PROJECT_NAME=backstory-wikitest
COMPOSE_FILE=compose.yaml:compose.host-data.yaml
BACKSTORY_IMAGE=backstory:local
# Positive numeric non-root IDs. Verify with id -u / id -g and the Docker mapping.
BACKSTORY_UID=1000
BACKSTORY_GID=1000
BACKSTORY_WIKI_ROOT='/absolute/path/to/testwiki'
# NEW private local directory outside the wiki; create it as host UID 1000 first.
BACKSTORY_DATA_HOST_PATH='/absolute/path/to/backstory-wikitest-data'
# Existing owner-approved root marker; contents are never read or hashed.
BACKSTORY_IDENTITY_PATH=.backstory-marker
BACKSTORY_WIKI_READ_ONLY=true
# Defaults below serve HTTP only on the Docker host loopback.
BACKSTORY_BIND_ADDRESS=127.0.0.1
BACKSTORY_PORT=8000
BACKSTORY_COOKIE_MODE=localhost
BACKSTORY_ALLOWED_HOSTS=localhost,127.0.0.1
BACKSTORY_PROXY_MODE=off
BACKSTORY_CSRF_TRUSTED_ORIGINS=
BACKSTORY_TRUSTED_PROXY_IPS=
BACKSTORY_PROXY_CLIENT_IP_HEADER=none
# Comma-separated additional deny patterns; empty means built-in exclusions only.
BACKSTORY_EXCLUSIONS=
# Logical payload quota; recovery retention remains 30 days.
BACKSTORY_REVISION_QUOTA_BYTES=67108864
# HTTPS behind any compatible proxy: see docs/setup.md before changing the
# security settings together. Set exact host/origin and actual trusted TCP peers;
# restrict origin reachability. Never use universal trust. Keep client header
# "none" unless the proxy overwrites a selected single-IP header.
# Application signing secret stays in private data, never in this file.
# To retain the original UID10001/named-volume fixture path instead, omit
# COMPOSE_FILE, BACKSTORY_UID/GID and BACKSTORY_DATA_HOST_PATH; see setup.md.
