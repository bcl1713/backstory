# Linux/rootful Docker example for an existing wiki owned by host UID/GID 1000.
# Copy to a NEW .env in the checkout, keep it private, then edit every path.
# Minimal read-only rehearsal. Full inventory/defaults: docs/configuration.md.
# Compose reads this file; do not source/eval it. Use absolute host paths, no ~.
COMPOSE_PROJECT_NAME=backstory-wikitest
COMPOSE_FILE=compose.yaml:compose.host-data.yaml
# Positive numeric non-root IDs. Verify with id -u / id -g and the Docker mapping.
BACKSTORY_UID=1000
BACKSTORY_GID=1000
BACKSTORY_WIKI_ROOT='/absolute/path/to/testwiki'
# NEW private local directory outside the wiki; create it as host UID 1000 first.
BACKSTORY_DATA_HOST_PATH='/absolute/path/to/backstory-wikitest-data'
# Existing owner-approved .backstory-marker is required; no hash is needed.
BACKSTORY_WIKI_READ_ONLY=true
# Defaults build backstory:local and serve HTTP only at 127.0.0.1:8000.
# For build-free Portainer/GHCR, use portainer.env.example and docs/portainer.md.
# HTTPS: add the settings together from docs/configuration.md or reverse-proxy.md.
# Optional exclusions, quota and worker settings are documented in the reference.
# Application signing secret stays in private data, never in this file.
# To retain the original UID10001/named-volume fixture path instead, omit
# COMPOSE_FILE, BACKSTORY_UID/GID and BACKSTORY_DATA_HOST_PATH; see setup.md.

# Optional Mermaid diagrams: empty keeps source-only rendering (disabled).
# Exact browser-origin requirements and activation: docs/mermaid-frame.md.
BACKSTORY_MERMAID_PARENT_ORIGIN=
BACKSTORY_GRAPHVIZ_PARENT_ORIGIN=
