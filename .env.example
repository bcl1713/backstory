# Generate synthetic storage with: uv run python -m tests.fixtures.generate /tmp/backstory-demo
# Then load its fixture.env as documented. Never point development at live notes.
BACKSTORY_WIKI_ROOT=/tmp/backstory-demo/wiki
BACKSTORY_DATA_DIR=/tmp/backstory-demo/data
BACKSTORY_IDENTITY_PATH=Home.md
# Fill from the generated manifest; this is not a secret.
BACKSTORY_IDENTITY_SHA256=
BACKSTORY_COOKIE_MODE=localhost
BACKSTORY_ALLOWED_HOSTS=localhost,127.0.0.1
